pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  environment {
    AWS_REGION = "ap-south-1"
    AWS_ACCOUNT_ID = "570617927874"

    ECR_REPO = "ml-infer"
    IMAGE_NAME = "ml-infer"

    ENDPOINT_NAME = "textcls-endpoint-dev"
    SAGEMAKER_EXEC_ROLE = "arn:aws:iam::570617927874:role/sagemaker-textcls-exec-role"

    MODEL_DATA_URL = "s3://sameer-ml-artifacts-ap-south-1/ml/textcls/versioned/v3.0.0/saved_model.tar.gz"
  }

  stages {

    stage("Checkout") {
      steps { checkout scm }
    }

    stage("Verify tools") {
      steps {
        sh """
          set -e
          docker --version
          aws --version
        """
      }
    }

    stage("Resolve Image Tag") {
      steps {
        script {
          def shortSha = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()

          // Base tag built by buildx (often becomes OCI index)
          env.IMAGE_TAG = "b${env.BUILD_NUMBER}-${shortSha}-amd64"

          // Converted tag guaranteed to be Docker v2 schema2 for SageMaker
          env.IMAGE_TAG_V2 = "${env.IMAGE_TAG}-v2"

          env.ECR_BASE = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com/${env.ECR_REPO}"
          env.IMAGE_URI = "${env.ECR_BASE}:${env.IMAGE_TAG}"
          env.IMAGE_URI_V2 = "${env.ECR_BASE}:${env.IMAGE_TAG_V2}"

          echo "IMAGE_URI (raw)    = ${env.IMAGE_URI}"
          echo "IMAGE_URI (v2s2)   = ${env.IMAGE_URI_V2}"
        }
      }
    }

    stage("Ensure ECR Repo") {
      steps {
        withCredentials([usernamePassword(
          credentialsId: "aws-cli",
          usernameVariable: "AWS_ACCESS_KEY_ID",
          passwordVariable: "AWS_SECRET_ACCESS_KEY"
        )]) {
          sh """
            set -e
            aws ecr describe-repositories --repository-names "${ECR_REPO}" --region "${AWS_REGION}" >/dev/null 2>&1 || \
            aws ecr create-repository --repository-name "${ECR_REPO}" --region "${AWS_REGION}" >/dev/null
          """
        }
      }
    }

    stage("Build & Push Image to ECR (buildx)") {
      steps {
        withCredentials([usernamePassword(
          credentialsId: "aws-cli",
          usernameVariable: "AWS_ACCESS_KEY_ID",
          passwordVariable: "AWS_SECRET_ACCESS_KEY"
        )]) {
          sh """
            set -e

            aws ecr get-login-password --region ${AWS_REGION} | \
              docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

            docker buildx create --name sm-builder --use || true

            docker buildx build \
              --platform linux/amd64 \
              -f inference/Dockerfile \
              -t ${IMAGE_URI} \
              --push .
          """
        }
      }
    }

    stage("Convert OCI -> Docker v2 schema2 (SageMaker compatible)") {
        steps {
            withCredentials([usernamePassword(
            credentialsId: "aws-cli",
            usernameVariable: "AWS_ACCESS_KEY_ID",
            passwordVariable: "AWS_SECRET_ACCESS_KEY"
            )]) {
            sh """
                set -e

                PASS=\$(aws ecr get-login-password --region ${AWS_REGION})

                docker run --rm \
                --entrypoint /bin/sh \
                -e PASS="\$PASS" \
                quay.io/skopeo/stable:latest -c '
                    set -e
                    skopeo --version
                    skopeo copy --format v2s2 \
                    --src-creds "AWS:\$PASS" \
                    --dest-creds "AWS:\$PASS" \
                    docker://${IMAGE_URI} \
                    docker://${IMAGE_URI_V2}
                '
            """
            }
        }
    }


    stage("Verify manifest is Docker v2") {
      steps {
        withCredentials([usernamePassword(
          credentialsId: "aws-cli",
          usernameVariable: "AWS_ACCESS_KEY_ID",
          passwordVariable: "AWS_SECRET_ACCESS_KEY"
        )]) {
          sh """
            set -e
            aws ecr batch-get-image \
              --repository-name ${ECR_REPO} \
              --image-ids imageTag=${IMAGE_TAG_V2} \
              --query 'images[].imageManifestMediaType' \
              --output text \
              --region ${AWS_REGION}
          """
        }
      }
    }

    stage("Deploy / Update SageMaker Endpoint (use v2 image)") {
      steps {
        withCredentials([usernamePassword(
          credentialsId: "aws-cli",
          usernameVariable: "AWS_ACCESS_KEY_ID",
          passwordVariable: "AWS_SECRET_ACCESS_KEY"
        )]) {
          sh """
            set -e

            docker run --rm \
              --volumes-from jenkins \
              -w "${WORKSPACE}" \
              -e AWS_ACCESS_KEY_ID \
              -e AWS_SECRET_ACCESS_KEY \
              -e AWS_REGION=${AWS_REGION} \
              python:3.10-slim bash -lc "
                pip install -q boto3 botocore &&
                python sagemaker/deploy.py \
                  --region ${AWS_REGION} \
                  --image-uri ${IMAGE_URI_V2} \
                  --model-data-url ${MODEL_DATA_URL} \
                  --execution-role-arn ${SAGEMAKER_EXEC_ROLE} \
                  --model-name textcls-model-${IMAGE_TAG_V2} \
                  --endpoint-config-name textcls-config-${IMAGE_TAG_V2} \
                  --endpoint-name ${ENDPOINT_NAME}
              "
          """
        }
      }
    }

    stage("Smoke Invoke Endpoint") {
      steps {
        withCredentials([usernamePassword(
          credentialsId: "aws-cli",
          usernameVariable: "AWS_ACCESS_KEY_ID",
          passwordVariable: "AWS_SECRET_ACCESS_KEY"
        )]) {
          sh """
            set -e

            docker run --rm \
              --volumes-from jenkins \
              -w "${WORKSPACE}" \
              -e AWS_ACCESS_KEY_ID \
              -e AWS_SECRET_ACCESS_KEY \
              -e AWS_REGION=${AWS_REGION} \
              python:3.10-slim bash -lc "
                pip install -q boto3 botocore &&
                python sagemaker/invoke.py \
                  --region ${AWS_REGION} \
                  --endpoint-name ${ENDPOINT_NAME} \
                  --text 'refund my money'
              "
          """
        }
      }
    }

  } // end stages

  post {
    success {
      echo "✅ CI/CD SUCCESS"
      echo "Raw Image: ${IMAGE_URI}"
      echo "SageMaker Image: ${IMAGE_URI_V2}"
      echo "Endpoint: ${ENDPOINT_NAME}"
    }
    failure {
      echo "❌ CI/CD FAILED — Check logs above"
      echo "Raw Image: ${IMAGE_URI}"
      echo "Attempted SageMaker Image: ${IMAGE_URI_V2}"
      echo "Endpoint: ${ENDPOINT_NAME}"
    }
  }
}
